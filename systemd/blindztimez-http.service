[Unit]
Description=BlindzTimez HTTP endpoint (Apple Shortcuts / LAN control)
# Transmits go through the radio, so it needs pigpiod too.
Wants=pigpiod.service network-online.target
After=pigpiod.service network-online.target

[Service]
Type=simple
# --- EDIT THESE for your Pi (must match blindztimez.service) ---
User=pi
Environment=BLINDZ_STATE_DIR=/home/pi/.config/blindztimez
ExecStart=/home/pi/blindz-venv/bin/blindz serve
# ---------------------------------------------------------------
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
